{
  "build": {
    "beforeDevCommand": "yarn prepare:builder && yarn dev",
    "beforeBuildCommand": "yarn prepare:builder && yarn build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["./convert", "./builder"],
    "icon": ["icons/linux.svg", "icons/mac.icns", "icons/win.ico", "icons/bcm_convertor.png"],
    "copyright": "小鱼yuzifu",
    "publisher": "小鱼yuzifu",
    "shortDescription": "编程猫格式工厂",
    "longDescription": "将自己在kitten3/4上的作品快速制作成独立应用程序",
    "category": "DeveloperTool"
  },
  "productName": "编程猫格式工厂",
  "mainBinaryName": "编程猫格式工厂",
  "version": "2.5.0",
  "identifier": "com.bcm-convertor.yzf",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "fullscreen": false,
        "resizable": false,
        "title": "编程猫格式工厂",
        "width": 640,
        "height": 440,
        "decorations": false,
        "shadow": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true,
        "label": "bcm_convertor",
        "useHttpsScheme": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic", "blur"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  }
}
