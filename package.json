{
  "name": "bcm_convertor",
  "description": "一键将 Kitten3/Kitten4/KittenN 作品打包为 Windows/Mac/Linux 桌面应用或 Android APK",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "prepare:builder": "node ./src-tauri/builder/scripts/prepare-builder.mjs",
    "prepare:android": "node ./src-tauri/builder/scripts/prepare-android.mjs",
    "prepare:all": "yarn prepare:android && yarn prepare:builder",
    "dev": "vite",
    "build": "vite build",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "preview": "vite preview",
    "tauri": "tauri",
    "icon:linux": "node ./scripts/generate-linux-icons.cjs",
    "package:linux": "bash ./scripts/package-linux.sh"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "antd": "^6.3.6",
    "pinyin": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sweetalert": "^2.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.10.1",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.11",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "rollup": "^4.52.5",
    "tailwindcss": "^4.2.4",
    "vite": "^7.1.7",
    "vite-plugin-top-level-await": "^1.6.0"
  }
}
